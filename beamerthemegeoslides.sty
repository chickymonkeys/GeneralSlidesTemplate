% The standout frame inverts the palette.
\setbeamercolor{standout}{bg=primarycolor, fg=backgroundcolor}

% ------------------------------------------------------------------------------
% Title page
% ------------------------------------------------------------------------------

% Write the authors and their affiliations the standard way,
%
%     \author{First Author \and Second Author}
%     \institute{First University \and Second University}
%
% and when there is one affiliation per author (and no \inst), each author is
% set with their affiliation underneath, in rows of authorsperrow. Otherwise the
% authors are set in rows and \institute underneath, as in plain Beamer, so
% \inst{1} superscripts keep working.
%
% The footer shows the short author list: \author[Short]{...} when given, and
% otherwise the names, "A and B" (joined with \geoslidesandname), or "A et al."
% from three authors up. It adds the short institute only when one is given,
% as in \institute[UCPH]{...}.

\newcommand{\geoslidesandname}{and}

\ExplSyntaxOn

\tl_new:N \g__geoslides_author_tl
\seq_new:N \g__geoslides_authors_seq
\seq_new:N \g__geoslides_shortauthors_seq
\seq_new:N \g__geoslides_institutes_seq
\bool_new:N \g__geoslides_shortauthor_bool
\bool_new:N \g__geoslides_shortinstitute_bool
\int_new:N \l__geoslides_count_int
\int_new:N \l__geoslides_perrow_int
\int_new:N \l__geoslides_rows_int
\dim_new:N \l__geoslides_cell_dim
\dim_new:N \l__geoslides_gap_dim
\tl_new:N \l__geoslides_row_tl

% Split a list at \and, dropping empty entries (a blank line is one too).
\cs_new_protected:Npn \__geoslides_split:Nn #1#2
{
  \seq_gset_split:Nnn #1 { \and } {#2}
  \seq_gremove_all:Nn #1 { }
  \seq_gremove_all:Nn #1 { \par }
}

% Record the lists as \author and \institute are given, then hand over to
% Beamer's own definitions.
\cs_new_eq:NN \__geoslides_beamer_author:w \beamer@author
\cs_gset_protected:Npn \beamer@author [#1] #2
{
  \__geoslides_beamer_author:w [#1] {#2}
  \tl_gset:Nn \g__geoslides_author_tl {#2}
  \__geoslides_split:Nn \g__geoslides_authors_seq {#2}
  \__geoslides_split:Nn \g__geoslides_shortauthors_seq {#1}
  \tl_if_eq:nnTF {#1} {#2}
  { \bool_gset_false:N \g__geoslides_shortauthor_bool }
  { \bool_gset_true:N \g__geoslides_shortauthor_bool }
}

\cs_new_eq:NN \__geoslides_beamer_institute:w \beamer@institute
\cs_gset_protected:Npn \beamer@institute [#1] #2
{
  \__geoslides_beamer_institute:w [#1] {#2}
  \__geoslides_split:Nn \g__geoslides_institutes_seq {#2}
  \tl_if_eq:nnTF {#1} {#2}
  { \bool_gset_false:N \g__geoslides_shortinstitute_bool }
  { \bool_gset_true:N \g__geoslides_shortinstitute_bool }
}

\prg_new_protected_conditional:Npnn \__geoslides_if_paired: { T, F, TF }
{
  \tl_if_in:NnTF \g__geoslides_author_tl { \inst }
  { \prg_return_false: }
  {
    \int_compare:nNnTF { \seq_count:N \g__geoslides_authors_seq } =
    { \seq_count:N \g__geoslides_institutes_seq }
    { \prg_return_true: }
    { \prg_return_false: }
  }
}

% Rows of authorsperrow; "auto" fits up to three to a row, balancing the rows.
\cs_new_protected:Npn \__geoslides_set_perrow:
{
  \int_set:Nn \l__geoslides_count_int { \seq_count:N \g__geoslides_authors_seq }
  \str_if_eq:VnTF \geoslides@authorsperrow { auto }
  {
    \int_set:Nn \l__geoslides_rows_int
    { \int_div_truncate:nn { \l__geoslides_count_int + 2 } { 3 } }
    \int_set:Nn \l__geoslides_perrow_int
    {
      \int_div_truncate:nn
      { \l__geoslides_count_int + \l__geoslides_rows_int - 1 }
      { \int_max:nn { \l__geoslides_rows_int } { 1 } }
    }
  }
  { \int_set:Nn \l__geoslides_perrow_int { \geoslides@authorsperrow } }
  \int_set:Nn \l__geoslides_perrow_int
  { \int_max:nn { \l__geoslides_perrow_int } { 1 } }
}

% A single \author entry with no paired affiliation -- one name, or a block
% laid out by hand -- is set as Beamer sets it; anything else as a grid.
\cs_new_protected:Npn \geoslides@authors
{
  \__geoslides_if_paired:TF
  { \__geoslides_grid: }
  {
    \int_compare:nNnTF { \seq_count:N \g__geoslides_authors_seq } > 1
    { \__geoslides_grid: }
    { \insertauthor }
  }
}

% Each author gets \textwidth/authorsperrow, and the cells of a full row are
% spread over the slide with equal gaps; a shorter last row keeps the same gaps
% and is centred, so its authors sit between those of the row above.
\cs_new_protected:Npn \__geoslides_grid:
{
  \__geoslides_set_perrow:
  \dim_set:Nn \l__geoslides_cell_dim
  { \textwidth / \l__geoslides_perrow_int }
  \dim_set:Nn \l__geoslides_gap_dim
  {
    ( \paperwidth - \l__geoslides_perrow_int \l__geoslides_cell_dim )
    / ( \l__geoslides_perrow_int + 1 )
  }
  \cs_set_eq:NN \inst \beamer@insttitle
  \tl_clear:N \l__geoslides_row_tl
  \par % the line Beamer's colour box opens: the space above the authors
  \seq_map_indexed_inline:Nn \g__geoslides_authors_seq
  {
    \tl_if_empty:NF \l__geoslides_row_tl
    { \tl_put_right:Nn \l__geoslides_row_tl { \hspace { \l__geoslides_gap_dim } } }
    \tl_put_right:Nn \l__geoslides_row_tl { \__geoslides_cell:nn {##1} {##2} }
    \bool_lazy_or:nnT
    { \int_compare_p:nNn { \int_mod:nn {##1} { \l__geoslides_perrow_int } } = 0 }
    { \int_compare_p:nNn {##1} = { \l__geoslides_count_int } }
    {
      \noindent \makebox [ 0pt ] { \tl_use:N \l__geoslides_row_tl } \par
      \int_compare:nNnT {##1} < { \l__geoslides_count_int } { \vspace{12pt} }
      \tl_clear:N \l__geoslides_row_tl
    }
  }
}

% One author: the name, and the affiliation under it when they are paired.
\cs_new_protected:Npn \__geoslides_cell:nn #1#2
{
  \parbox [t] { \l__geoslides_cell_dim }
  {
    \centering #2
    \__geoslides_if_paired:T
    {
      \\
      { \usebeamerfont{institute} \seq_item:Nn \g__geoslides_institutes_seq {#1} }
    }
  }
}

\cs_new_protected:Npn \geoslides@institute
{ \__geoslides_if_paired:F { \insertinstitute } }

\cs_new_protected:Npn \geoslides@shortauthor
{
  \group_begin:
  \cs_set_eq:NN \inst \use_none:n
  \cs_set_eq:NN \thanks \use_none:n
  \bool_lazy_and:nnTF
  { ! \g__geoslides_shortauthor_bool }
  { \int_compare_p:nNn { \seq_count:N \g__geoslides_shortauthors_seq } > 2 }
  { \seq_item:Nn \g__geoslides_shortauthors_seq { 1 } ~ et~al. }
  {
    \seq_use:Nnnn \g__geoslides_shortauthors_seq
    { \c_space_tl \geoslidesandname \c_space_tl }
    { , \c_space_tl }
    { \c_space_tl \geoslidesandname \c_space_tl }
  }
  \group_end:
}

\cs_new_protected:Npn \geoslides@shortinstitute
{
  \bool_if:NT \g__geoslides_shortinstitute_bool
  {
    \exp_args:NV \tl_if_blank:nF \beamer@shortinstitute
    { ~ ~ ( \insertshortinstitute ) }
  }
}

\ExplSyntaxOff

\defbeamertemplate*{author}{geoslides}[1][]{%
  \begin{beamercolorbox}[sep=8pt,center,#1]{author}
    \usebeamerfont{author}\geoslides@authors
  \end{beamercolorbox}
}

\defbeamertemplate*{institute}{geoslides}[1][]{%
  \begin{beamercolorbox}[sep=8pt,center,#1]{institute}
    \usebeamerfont{institute}\geoslides@institute
  \end{beamercolorbox}
}

% \maketitle sets the title page on a plain frame, with no footer.
\renewcommand{\maketitle}{%
  \ifbeamer@inframe\titlepage\else\frame[plain]{\titlepage}\fi
}

% ------------------------------------------------------------------------------
% Frame title: a bar on the left edge, the title, the subtitle under it, and
% the \logo, if any, at the right end.
% ------------------------------------------------------------------------------

\setbeamertemplate{headline}{}
\setbeamertemplate{sidebar right}{}   % Beamer's default puts \logo down here

% Each TikZ command below fits on one line. VimTeX indents the continuation
% lines of a TikZ command only once it knows the deck loads TikZ, which depends
% on whether the deck has been compiled, so a command split over lines would be
% indented differently from one save to the next.
\newcommand{\geoslides@frametitletext}{%
  \usebeamerfont{frametitle}\insertframetitle
}
\newcommand{\geoslides@framesubtitletext}{%
  \usebeamercolor[fg]{framesubtitle}\usebeamerfont{framesubtitle}\insertframesubtitle
}

\defbeamertemplate*{frametitle}{geoslides}[1][]{%
  \vskip0.5cm%
  \begin{beamercolorbox}[wd=\paperwidth,ht=1.2cm]{frametitle}
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\the\paperwidth,1.2);
      \usebeamercolor{frametitle-left}%
      \fill[color=frametitle-left.fg] (0,0) rectangle (0.2,1.2);
      \ifx\insertframesubtitle\@empty
        \node[anchor=west] at (0.3,0.61) {\geoslides@frametitletext};
      \else
        \node[anchor=west] at (0.2,0.81) {\geoslides@frametitletext};
        \node[anchor=west] at (0.4,0.25) {\geoslides@framesubtitletext};
      \fi
      \node[anchor=east] at (\paperwidth-0.4cm,0.6) {\insertlogo};
    \end{tikzpicture}
  \end{beamercolorbox}
}

\setbeamertemplate{frametitle continuation}[from second][(contd.)]

% ------------------------------------------------------------------------------
% Footer: authors | short title (and the appendix link) | date and frame number
% ------------------------------------------------------------------------------

% The appendix link points at the first frame after \appendix, and shows only
% in decks that have one.
\newcommand{\geoslides@appendixtarget}{\hyperlinkappendixstart}
\newcommand{\geoslides@appendixlink}{%
  \ifgeoslides@appendixlink
    \ifx\beamer@startpageofappendix\@empty\else
      \enspace\geoslides@appendixtarget{\usebeamercolor[fg]{footer link}\appendixname}%
    \fi
  \fi
}

\setbeamertemplate{footline}{%
  \begin{beamercolorbox}{footlinecolor}
    \leavevmode%
    \hbox{%
      \begin{beamercolorbox}[wd=.33\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
        \usebeamerfont{author in head/foot}%
        \geoslides@shortauthor\geoslides@shortinstitute
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.33\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
        \usebeamerfont{title in head/foot}%
        {\hypersetup{hidelinks}\insertshorttitle}%
        \geoslides@appendixlink
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.33\paperwidth,ht=2.25ex,dp=1ex,leftskip=.1cm,rightskip=.1cm plus1fil]{date in head/foot}%
        \usebeamerfont{date in head/foot}%
        \hfill\insertshortdate\hfill
        \insertframenumber{} / \inserttotalframenumber\hfill
      \end{beamercolorbox}%
    }%
    \vskip0pt%
  \end{beamercolorbox}%
}

\setbeamertemplate{navigation symbols}{}

% ------------------------------------------------------------------------------
% Standout frames: \begin{frame}[standout] ... \end{frame}
% ------------------------------------------------------------------------------

% One sentence, centred, on the inverted palette, with no title and no footer.
\newif\ifgeoslides@standout
\define@key{beamerframe}{standout}[true]{%
  \geoslides@standouttrue
  \begingroup
  \setkeys{beamerframe}{plain,c}%
  \setbeamercolor{background canvas}{use=standout, bg=standout.bg}%
}
\pretocmd{\beamer@reseteecodes}{%
  \ifgeoslides@standout\endgroup\geoslides@standoutfalse\fi
}{}{}
\AtBeginEnvironment{beamer@frameslide}{%
  \ifgeoslides@standout
    \centering\usebeamercolor[fg]{standout}\usebeamerfont{standout}%
  \fi
}

% ------------------------------------------------------------------------------
% Links between slides
% ------------------------------------------------------------------------------

% \slidelink{label}{text} jumps to the frame with that label;
% \slideback{label} is the link back, worded by \slidebackname.
\newcommand{\slidebackname}{Back}
\newcommand{\slidelink}[2]{\hyperlink{#1}{\beamerbutton{#2}}}
\newcommand{\slideback}[1]{\hyperlink{#1}{\beamerbutton{\slidebackname}}}

% Emphasis in the accent colour; \alert does the same.
\newcommand{\shine}[1]{\textcolor{secondarycolor}{#1}}

% Commands from version 1, kept so older decks compile unchanged. They do
% nothing now: \appendix numbers the backup slides apart, and the title page
% prints \titlegraphic.
\newcommand{\backupbegin}{}
\newcommand{\backupend}{}
\newcommand{\frontlogo}{}

% ------------------------------------------------------------------------------
% Captions, theorems
% ------------------------------------------------------------------------------

\captionsetup{%
  justification=justified, skip=5pt, labelformat=simple,%
  font=scriptsize, position=bottom%
}
\captionsetup[subfloat]{%
  justification=centering, skip=0pt, font=scriptsize, position=top%
}

\setbeamertemplate{theorems}[numbered]

% ------------------------------------------------------------------------------
% Bibliography: author-year citations, AER-style reference list
% ------------------------------------------------------------------------------

\ifgeoslides@biblatex
  \RequirePackage[
  backend=biber,
  style=authoryear-comp,  % author-year, compressed multiple citations
  natbib=true,            % \citet and \citep
  sorting=ynt,            % several citations in one command: by date
  sortcites=true,         % (the reference list: \newrefcontext[sorting=nyt])
  uniquename=false,
  uniquelist=false,
  maxcitenames=3,
  maxbibnames=99,
  dashed=false
  ]{biblatex}

  % Fields not printed in the reference list
  \AtEveryBibitem{%
    \clearfield{issn}%
    \clearfield{eprint}%
    \clearfield{eprinttype}%
    \clearfield{urldate}%
    \clearfield{url}%
    \clearfield{note}%
    \clearfield{urlyear}%
    \clearfield{urlmonth}%
  }

  % Double quotes around titles, even in British English.
  \DeclareLanguageMapping{british}{american}

  % Citations in citecolor; the reference list in the text colour.
  \AtEveryCite{\color{citecolor}}
  \AtBeginBibliography{%
    \hypersetup{citecolor=normaltext, linkcolor=normaltext, urlcolor=normaltext}%
  }

  % No "In:" before journal names (kept for chapters and the like). The test
  % is \iffieldequalstr rather than \ifentrytype, whose \if... prefix VimTeX's
  % indentation would read as a TeX conditional waiting for its \fi.
  \renewbibmacro*{in:}{%
    \iffieldequalstr{entrytype}{article}{}{%
      \printtext{\bibstring{in}\intitlepunct}%
    }%
  }

  % Journal 101 (3): 385--409
  \renewbibmacro*{volume+number+eid}{%
    \printfield{volume}%
    \setunit*{\addnbspace}%
    \printfield[parens]{number}%
    \setunit{\addcolon\addspace}%
    \printfield{eid}%
  }
  \DeclareFieldFormat[article]{pages}{#1}
  \renewbibmacro*{note+pages}{%
    \printfield{note}%
    \setunit{\addcolon\addspace}%
    \printfield{pages}%
  }
\fi

\mode<all>
