% ---------------------------------------------------------------------------- %
% GeoSlides: a Beamer theme for academic presentations                         %
% Modified from the NHH-FAIR Template for Presentations                        %
% Author: Alessandro Pizzigolotto (UCPH)                                       %
% ---------------------------------------------------------------------------- %
%
% Load it the standard Beamer way, in the deck preamble:
%
%     \usetheme{geoslides}
%     \usetheme[palette=nhh, authorsperrow=3]{geoslides}
%
% and write the deck in plain Beamer: \begin{frame}{Title}{Subtitle}, columns,
% figure, table, block, \pause, \appendix ... The theme styles all of it.
%
% Options (all optional, in any order):
%
%   palette=ku|nhh|mit|fair   colour palette (default: ku)
%   housefont=true|false      Neutra Text for the text (default: true; needs
%                             XeLaTeX or LuaLaTeX, falls back to Latin Modern)
%   fontpath=<dir/>           where Neutra Text lives (default: fonts/)
%   authorsperrow=<n>|auto    authors per row on the title page (default: auto)
%   appendixlink=true|false   "Appendix" link in the footer of decks that have
%                             an \appendix (default: true)
%   biblatex=true|false       load biblatex with the house citation style
%                             (default: true; false to set up your own)
%
% The colour roles (primarycolor, secondarycolor, normaltext, citecolor, ...)
% are ordinary xcolor names: redefine any of them with \colorlet after
% \usetheme, e.g. \colorlet{primarycolor}{darkbluenhh}.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemegeoslides}[2026/10/20 v2.0 GeoSlides Beamer theme]

% ------------------------------------------------------------------------------
% Options
% ------------------------------------------------------------------------------

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=geoslides, prefix=geoslides@}
\DeclareStringOption[ku]{palette}
\DeclareBoolOption[true]{housefont}
\DeclareStringOption[fonts/]{fontpath}
\DeclareStringOption[auto]{authorsperrow}
\DeclareBoolOption[true]{appendixlink}
\DeclareBoolOption[true]{biblatex}
\ProcessKeyvalOptions*

\mode<presentation>

% ------------------------------------------------------------------------------
% Packages
% ------------------------------------------------------------------------------

% What the theme itself needs
\RequirePackage{etoolbox}
\RequirePackage{iftex}
\RequirePackage{tikz}                    % the frame title bar
\RequirePackage{appendixnumberbeamer}    % backup slides numbered apart

% What nearly every academic deck needs
\RequirePackage{amsmath, amssymb}
\RequirePackage{booktabs, multirow}      % tables from estimation code
\RequirePackage[para]{threeparttable}    % \begin{tablenotes} under a table
\RequirePackage{caption, subcaption}     % captions and figure panels
\RequirePackage[autostyle=try]{csquotes} % \enquote, displayquote

% ------------------------------------------------------------------------------
% Fonts
% ------------------------------------------------------------------------------

% Text in Neutra Text, maths in Palatino. Neutra Text is an OpenType font, so
% it needs XeLaTeX or LuaLaTeX; it is looked for in fontpath first and then
% among the installed fonts. Without it (or under pdfLaTeX) the deck still
% compiles, in Latin Modern Sans.
\usefonttheme{professionalfonts}

\iftutex
  \RequirePackage{mathpazo}
  \RequirePackage[no-math]{fontspec}
  \newcommand{\geoslides@neutra}[1]{%
    \setsansfont{NeutraText-Book}[%
    #1,
    Extension      = .otf,
    ItalicFont     = NeutraText-BookItalic,
    BoldFont       = NeutraText-Bold,
    BoldItalicFont = NeutraText-BoldItalic
    ]%
  }
  \ifgeoslides@housefont
    \IfFileExists{\geoslides@fontpath NeutraText-Book.otf}{%
      \geoslides@neutra{Path=\geoslides@fontpath}%
    }{%
      \IfFontExistsTF{NeutraText-Book.otf}{%
        \geoslides@neutra{}%
      }{%
        \PackageWarningNoLine{beamerthemegeoslides}{%
          Neutra Text is neither in '\geoslides@fontpath' nor\MessageBreak
          installed, so the text is set in Latin Modern Sans.\MessageBreak
          Set the theme option fontpath=<dir/> to point at it%
        }%
      }%
    }%
  \fi
\else
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
  \RequirePackage{mathpazo}
  \ifgeoslides@housefont
    \PackageInfo{beamerthemegeoslides}{%
      Neutra Text needs XeLaTeX or LuaLaTeX; using Latin Modern Sans%
    }%
  \fi
\fi

\setbeamerfont{frametitle}{size=\Large}
\setbeamerfont{framesubtitle}{size=\small}
\setbeamerfont{institute}{size=\footnotesize, shape=\itshape}
\setbeamerfont{description item}{series=\bfseries}
\setbeamerfont{standout}{size=\Large}

