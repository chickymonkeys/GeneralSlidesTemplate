% ---------------------------------------------------------------------------- %
% GeoSlides layout vocabulary (optional)                                       %
% Author: Alessandro Pizzigolotto (UCPH)                                       %
% ---------------------------------------------------------------------------- %
%
% The frame vocabulary of GeoSlides 1.x, kept for decks written against it and
% for the deck generator that fills it. New decks do not need it: write plain
% Beamer frames and the theme styles them. Load it after the theme:
%
%     \usetheme{geoslides}
%     \usepackage{geoslidesframes}
%
% Nine frames:
%
%   \titleframe                       the title page
%   \begin{standoutframe} ... \end    one full-bleed sentence, inverted colours
%   \begin{contentframe}  ... \end    prose, bullets and equations, top-aligned
%   \begin{figureframe}   ... \end    one figure, centred and fitted
%   \begin{tableframe}    ... \end    one table, centred and fitted
%   \begin{splitframe}    ... \end    two columns, separated by \splitnext
%   \begin{closingframe}  ... \end    the thank-you slide
%   \outlineframe                     the table of contents
%   \backupdividerframe               the divider that opens the appendix
%
% plus \slidefigure and \slidetable, \addauthor and \authorsperrow, and
% \appendixindexlink. See docs/layout-vocabulary.md for the reference.
%
% Frames that have a body are environments taking keyval options; frames that
% have none are plain macros, and \outlineframe and \backupdividerframe take
% the same keyval options (the title page takes none).
%
% The environments are \newenvironment, not \NewDocumentEnvironment. Beamer
% collects a frame body by scanning ahead for \end{frame}, and xparse's
% environment machinery hides that \end{frame} in its own code, so the scan
% never finds it and the body runs away to end of file.
%
% Where a frame is opened in one macro and closed in another, the code writes
% \begin {frame} and \end {frame}. TeX ignores the space, so beamer sees its
% \end{frame} as before, but VimTeX's indentation no longer takes the frame for
% an environment left open and shifts every line below it.
%
% These frames wrap Beamer's own frame environment, so a slide that needs
% [fragile] -- verbatim, listings, minted -- has to be a plain
% \begin{frame}[fragile].

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{geoslidesframes}[2026/10/20 v2.0 GeoSlides layout vocabulary]

\RequirePackage{pgfkeys}
\RequirePackage{graphicx}

% ------------------------------------------------------------------------------
% Frame options
% ------------------------------------------------------------------------------

\newif\ifgeoslides@isindex

% Every frame understands title, subtitle, label and links. The rest belong to
% one frame each and are ignored by the others.
\pgfkeys{/geoslides/frame/.cd,
  title/.store in      = \geoslides@title,      % the frame title
  subtitle/.store in   = \geoslides@subtitle,   % the qualifying line under it
  label/.store in      = \geoslides@label,      % anchor name, for \slidelink
  links/.store in      = \geoslides@links,      % links about the whole frame
  leftwidth/.store in  = \geoslides@leftwidth,  % splitframe: left column width
  rightwidth/.store in = \geoslides@rightwidth, % splitframe: right column width
  message/.store in    = \geoslides@message,    % closingframe: the sign-off
  contact/.store in    = \geoslides@contact,    % closingframe: an email address
  toc/.store in        = \geoslides@toc,        % outlineframe: \tableofcontents options
  index/.is if         = geoslides@isindex,     % outlineframe: this is the appendix index
}

% The anchor the appendix index always carries, so the footer link below has a
% fixed target to point at.
\newcommand{\geoslides@indexanchor}{geoslides:appendixindex}

\newcommand{\geoslides@setkeys}[1]{%
  \def\geoslides@title{}%
  \def\geoslides@subtitle{}%
  \def\geoslides@label{}%
  \def\geoslides@links{}%
  \def\geoslides@leftwidth{.48\textwidth}%
  \def\geoslides@rightwidth{.48\textwidth}%
  \def\geoslides@message{}%
  \def\geoslides@contact{}%
  \def\geoslides@toc{}%
  \geoslides@isindexfalse
  \pgfqkeys{/geoslides/frame}{#1}%
}

% Open beamer's frame. The alignment argument is always there, so the option
% list is never empty; label= is added only when the deck asked for an anchor,
% because beamer keeps a copy of every labelled frame and there is no reason to
% pay that for frames nothing links to. The label value is wrapped in braces:
% beamer's option parser trips over a ':' inside an unwrapped value and the
% whole frame silently vanishes, which is how \slidelink targets are spelled.
% The \edef turns the options into literal tokens, which is what beamer's
% option parser needs to see.
\newcommand{\geoslides@openframe}[1]{%
  \ifx\geoslides@label\@empty
    \edef\geoslides@next{\noexpand\begin {frame}[#1]}%
  \else
    \edef\geoslides@next{\noexpand\begin {frame}[#1,label={\geoslides@label}]}%
  \fi
  \geoslides@next
}

% Title and subtitle. Frame-level links print at the end of the subtitle line,
% which is where a hand-written deck already puts them.
\newcommand{\geoslides@titleline}{%
  \frametitle{\geoslides@title}%
  \ifx\geoslides@subtitle\@empty
    \ifx\geoslides@links\@empty\else\framesubtitle{\geoslides@links}\fi
  \else
    \ifx\geoslides@links\@empty
      \framesubtitle{\geoslides@subtitle}%
    \else
      \framesubtitle{\geoslides@subtitle\enspace\geoslides@links}%
    \fi
  \fi
}

% ------------------------------------------------------------------------------
% Navigation
% ------------------------------------------------------------------------------

% \slidelink and \slideback live in the theme. \appendixindexlink points the
% theme's footer link at the appendix index (\outlineframe[index]) instead of
% the first frame of the appendix.
\newcommand{\appendixindexlink}{%
  \geoslides@appendixlinktrue
  \renewcommand{\geoslides@appendixtarget}{\hyperlink{\geoslides@indexanchor}}%
}

% ------------------------------------------------------------------------------
% Artifact blocks
% ------------------------------------------------------------------------------

% A figure or a table arrives as one of these. They own the fitting, so no deck
% writes \resizebox or keepaspectratio itself.

\pgfkeys{/geoslides/artifact/.cd,
  width/.store in   = \geoslides@width,    % how wide to draw it
  height/.store in  = \geoslides@height,   % the ceiling it may not exceed
  caption/.store in = \geoslides@caption,  % the paragraph under it
  note/.store in    = \geoslides@note,     % a short source or reading line
  label/.store in   = \geoslides@artlabel, % anchor name, for \ref
  link/.store in    = \geoslides@artlink,  % a link belonging to this artifact
  kind/.store in    = \geoslides@kind,     % table only: input or file
}

\newcommand{\geoslides@setartifactkeys}[3]{%
  \def\geoslides@width{#1}%
  \def\geoslides@height{#2}%
  \def\geoslides@caption{}%
  \def\geoslides@note{}%
  \def\geoslides@artlabel{}%
  \def\geoslides@artlink{}%
  \def\geoslides@kind{input}%
  \pgfqkeys{/geoslides/artifact}{#3}%
}

% Read a .tex fragment written by the estimation code, without opening a group
% around it, so the table body lands where it is asked to.
\newcommand*\geoslides@readfragment[1]{\@@input#1 }

% Scale content to the given width; if that leaves it taller than the given
% ceiling, scale to the ceiling instead. This is the whole of the template's
% overflow duty for artifacts.
\newsavebox{\geoslides@fitbox}
\newcommand{\geoslides@fit}[3]{%
  \sbox\geoslides@fitbox{\resizebox{#1}{!}{#3}}%
  \ifdim\dimexpr\ht\geoslides@fitbox+\dp\geoslides@fitbox\relax>\dimexpr#2\relax
    \sbox\geoslides@fitbox{\resizebox{!}{#2}{#3}}%
  \fi
  \usebox\geoslides@fitbox
}

% The caption, then the optional note, then the optional link. The note undoes
% the surrounding \centering so it sets as a justified paragraph like the
% caption above it.
\newcommand{\geoslides@artifactfoot}{%
  \ifx\geoslides@caption\@empty\else
    \caption{\geoslides@caption}%
  \fi
  \ifx\geoslides@artlabel\@empty\else
    \label{\geoslides@artlabel}%
  \fi
  \ifx\geoslides@note\@empty\else
    \par\vspace{2pt}%
    {%
      \usebeamercolor[fg]{caption}\scriptsize
      \leftskip\z@ \rightskip\z@ \parfillskip\z@ plus 1fil\relax
      \geoslides@note\par
    }%
  \fi
  \ifx\geoslides@artlink\@empty\else
    \par\vspace{2pt}{\centering\geoslides@artlink\par}%
  \fi
}

% \slidefigure[keys]{path} -- a figure the project's own code wrote, or one
% exported from someone else's PDF; by the time it reaches here it is a file.
\newcommand{\slidefigure}[2][]{%
  \begingroup
  \geoslides@setartifactkeys{.9\linewidth}{.75\textheight}{#1}%
  \begin{figure}
    \centering
    \includegraphics[width=\geoslides@width,height=\geoslides@height,keepaspectratio]{#2}%
    \geoslides@artifactfoot
  \end{figure}%
  \endgroup
}

% \slidetable[keys]{path} -- by default a .tex fragment pulled in with
% kind=input; kind=file draws an image instead, which is how a table recovered
% from someone else's PDF as a vector clip arrives.
\newcommand{\geoslides@filekind}{file}
\newcommand{\slidetable}[2][]{%
  \begingroup
  \geoslides@setartifactkeys{\linewidth}{.72\textheight}{#1}%
  \begin{table}
    \centering
    \ifx\geoslides@kind\geoslides@filekind
      \includegraphics[width=\geoslides@width,height=\geoslides@height,keepaspectratio]{#2}%
    \else
      \geoslides@fit{\geoslides@width}{\geoslides@height}{\geoslides@readfragment{#2}}%
    \fi
    \geoslides@artifactfoot
  \end{table}%
  \endgroup
}

% ------------------------------------------------------------------------------
% Frames
% ------------------------------------------------------------------------------

% The title page. Everything on it comes from the deck header: \title,
% \subtitle, \addauthor (or \author), \institute and \date.
\newcommand{\titleframe}{%
  \begin{frame}[plain,c]
    \titlepage
  \end{frame}%
}

% One sentence, full bleed, palette inverted. No frame title, no headline and no
% footer, so nothing on the slide competes with the sentence.
\newenvironment{standoutframe}[1][]
{%
  \geoslides@setkeys{#1}%
  \geoslides@openframe{standout}%
}
{%
  \par
  \end {frame}%
}

% Prose, bullets and equations, in whatever order the slide needs them. Content
% starts at the top and flows down the page.
\newenvironment{contentframe}[1][]
{%
  \geoslides@setkeys{#1}%
  \geoslides@openframe{t}%
  \geoslides@titleline
}
{%
  \end {frame}%
}

% One figure, vertically centred in the space the frame title leaves. The body
% is a single \slidefigure.
\newenvironment{figureframe}[1][]
{%
  \geoslides@setkeys{#1}%
  \geoslides@openframe{c}%
  \geoslides@titleline
}
{%
  \end {frame}%
}

% One table, vertically centred. The body is a single \slidetable.
\newenvironment{tableframe}[1][]
{%
  \geoslides@setkeys{#1}%
  \geoslides@openframe{c}%
  \geoslides@titleline
}
{%
  \end {frame}%
}

% Two columns. Write the left column, then \splitnext, then the right one --
% "text left, figure right" and "two columns of bullets" are the same frame with
% different contents, so there is only this one.
%
% The columns are two \vtop boxes in an \hbox, not beamer's columns
% environment: beamer collects a frame body by counting literal \begin and
% \end tokens, so an environment whose begin code opens \begin{columns} can
% never be balanced -- the matching \end tokens live in the end code, invisible
% to the collector, and the body runs away to end of file. The \vtop pair is
% invisible to that collector and keeps the same user surface: a left column,
% \splitnext, a right column. Alignment is the template's job either way.
\newenvironment{splitframe}[1][]
{%
  \geoslides@setkeys{#1}%
  \geoslides@openframe{t}%
  \geoslides@titleline
  \hbox to\linewidth\bgroup
  \vtop\bgroup\hsize=\geoslides@leftwidth\relax\linewidth=\hsize\relax
}
{%
  \egroup
  \egroup
  \end {frame}%
}

\newcommand{\splitnext}{%
  \egroup
  \hfil
  \vtop\bgroup\hsize=\geoslides@rightwidth\relax\linewidth=\hsize\relax
}

% The thank-you slide: a headline (the deck title unless another is given), a
% sign-off and an address. Anything in the body prints underneath.
\newenvironment{closingframe}[1][]
{%
  \geoslides@setkeys{#1}%
  \geoslides@openframe{c}%
  \centering
  \ifx\geoslides@title\@empty
    {\LARGE\inserttitle\par}%
  \else
    {\LARGE\geoslides@title\par}%
  \fi
  \vspace{3em}%
  \ifx\geoslides@message\@empty\else
    {\Large\geoslides@message\par}%
    \vspace{1em}%
  \fi
  \ifx\geoslides@contact\@empty\else
    {\Large\href{mailto:\geoslides@contact}{\geoslides@contact}\par}%
    \vspace{1em}%
  \fi
}
{%
  \par
  \end {frame}%
}

% The table of contents. Plain \outlineframe after the deck header prints the
% whole thing; \outlineframe[toc=currentsection] at a section boundary prints
% the section it is opening. Inside the appendix it lists the backup sections,
% which is the index every backup slide is reachable from -- mark that one with
% \outlineframe[index] so the footer link can find it.
\newcommand{\outlinename}{Outline}
\newcommand{\outlineframe}[1][]{%
  \begingroup
  \geoslides@setkeys{#1}%
  \ifx\geoslides@title\@empty\def\geoslides@title{\outlinename}\fi
  \ifgeoslides@isindex
    \ifx\geoslides@label\@empty
      \let\geoslides@label\geoslides@indexanchor
    \fi
  \fi
  \geoslides@openframe{t}%
  \geoslides@titleline
  \ifx\geoslides@toc\@empty
    \tableofcontents
  \else
    \edef\geoslides@next{\noexpand\tableofcontents[\geoslides@toc]}%
    \geoslides@next
  \fi
  \end {frame}%
  \endgroup
}

% The divider that opens the appendix. Put \appendix before it: that is what
% restarts the frame numbering and keeps the backup slides out of the total.
\newcommand{\backupdividername}{Backup Slides}
\newcommand{\backupdividerframe}[1][]{%
  \begingroup
  \geoslides@setkeys{#1}%
  \ifx\geoslides@title\@empty\def\geoslides@title{\backupdividername}\fi
  \geoslides@openframe{c}%
  \centering
  {\LARGE\geoslides@title\par}%
  \ifx\geoslides@subtitle\@empty\else
    \vspace{1em}{\large\geoslides@subtitle\par}%
  \fi
  \end {frame}%
  \endgroup
}

% ------------------------------------------------------------------------------
% The multi-author title block
% ------------------------------------------------------------------------------

% \addauthor[Surname]{Full Name}{Affiliation}, once per author, in the deck
% preamble. It re-issues \author with every author so far, each with their
% affiliation under the name, and the short names for the footer ("First and
% Second"); the theme lays them out in rows. New decks can write
% \author{A \and B} and \institute{X \and Y} instead.
%
% \authorsperrow{n} is the theme option authorsperrow=n.

\newcommand{\authorsperrow}[1]{\def\geoslides@authorsperrow{#1}}

\newcommand{\geoslides@addedauthors}{}
\newcommand{\geoslides@addedshort}{}

\newcommand{\addauthor}[3][]{%
  \def\geoslides@shortname{#1}%
  \ifx\geoslides@shortname\@empty\def\geoslides@shortname{#2}\fi
  \ifx\geoslides@addedauthors\@empty\else
    \g@addto@macro\geoslides@addedauthors{\and}%
    \g@addto@macro\geoslides@addedshort{\and}%
  \fi
  \g@addto@macro\geoslides@addedauthors{%
    #2\texorpdfstring{\\{\usebeamerfont{institute}#3}}{}%
  }%
  \expandafter\g@addto@macro\expandafter\geoslides@addedshort
  \expandafter{\geoslides@shortname}%
  \begingroup
  \edef\geoslides@next{%
    \endgroup
    \noexpand\author[\unexpanded\expandafter{\geoslides@addedshort}]%
    {\unexpanded\expandafter{\geoslides@addedauthors}}%
  }%
  \geoslides@next
}
